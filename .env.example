# Copier vers .env.local (ignoré par git) et renseigner.
# ID client OAuth « Application Web » (public par nature, mais propre à chaque projet Google Cloud)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx-xxxxxxxx.apps.googleusercontent.com
# Identifiant de la Google Sheet (la partie entre /d/ et /edit dans l'URL)
VITE_SHEET_ID=your-spreadsheet-id
